+            GL13.glActiveTexture(GL13.GL_TEXTURE2);
+            if (s.texture2 != null) GL11.glBindTexture(GL11.GL_TEXTURE_2D, s.texture2.getID());
+            else GL11.glDisable(GL11.GL_TEXTURE_2D);
