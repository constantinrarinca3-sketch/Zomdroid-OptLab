+            GL20.glVertexAttribPointer(2,4,GL11.GL_UNSIGNED_BYTE,true,36,16L);
+            GL20.glVertexAttribPointer(3,2,GL11.GL_FLOAT,false,36,20L);
+            GL20.glVertexAttribPointer(4,2,GL11.GL_FLOAT,false,36,28L);
+        }
