+                if (keys[i] == k) return true;
+                i = (i + 1) & m;
+            }
+            return false;
+        }
+        void add(long k) {
+            if ((size + 1) * 10 >= keys.length * 7) rehash(keys.length << 1);
+            int m = keys.length - 1;
+            int i = mix(k) & m;
+            while (used[i] != 0) {
+                if (keys[i] == k) return;
+                i = (i + 1) & m;
+            }
+            used[i] = 1; keys[i] = k; size++;
