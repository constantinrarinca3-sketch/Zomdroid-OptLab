+    private static String workerLine(String prefix, Coord c, long workerNs, WorkerCtx w) {
+        long sum = w.ensure3x3Ns + w.recalcPropsNs + w.recalcNeighboursNs;
+        return prefix + " chunk=" + fmtCoord(c)
