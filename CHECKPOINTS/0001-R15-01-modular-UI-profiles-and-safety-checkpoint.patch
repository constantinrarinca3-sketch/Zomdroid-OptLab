+                || rb.sequence < 0 || rb.sequence >= rb.vbo.length || rb.sequence >= rb.ibo.length
+                || rb.vbo[rb.sequence] == null || rb.ibo[rb.sequence] == null || Model.modelDrawCounts == null) {
