+        if (rb.currentRun == null) {
+            ++initial; ++changed; publishStateMaybe(); return true;
+        }
+        if (d.type == TextureDraw.Type.DrawModel) {
+            ++drawModel; ++changed; publishStateMaybe(); return true;
