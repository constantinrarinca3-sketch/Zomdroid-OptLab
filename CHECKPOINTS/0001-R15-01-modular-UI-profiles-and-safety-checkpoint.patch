+
+    /** Exact StartShader case with one common-path ShaderMap lookup instead of containsKey()+get(). */
+    private static void runStartShaderExact(TextureDraw o) {
+        final int id=o.a;
+        ShaderHelper.glUseProgramObjectARB(id);
+        final Integer key=Integer.valueOf(id);
+        final Shader shader=Shader.ShaderMap.get(key);
