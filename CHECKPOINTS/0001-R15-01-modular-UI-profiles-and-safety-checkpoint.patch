+    private static void addStat(String name, long ns) {
+        Stats st = stats.get(name);
+        if (st == null) {
+            Stats fresh = new Stats();
+            Stats raced = stats.putIfAbsent(name, fresh);
+            st = raced == null ? fresh : raced;
+        }
+        st.add(ns, ns >= spikeNs());
+    }
