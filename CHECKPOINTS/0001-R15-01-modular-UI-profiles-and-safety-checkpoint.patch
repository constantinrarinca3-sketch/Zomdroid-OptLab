+            c.program = null;
+            c.epoch = shaderRegistryEpoch;
+            c.id = id;
+            return;
+        }
+        c.owner = owner;
+        c.id = id;
+        c.program = program;
+        c.epoch = shaderRegistryEpoch;
+        if (!rthreadLeanTelemetry) ++c.cacheStores;
+    }
