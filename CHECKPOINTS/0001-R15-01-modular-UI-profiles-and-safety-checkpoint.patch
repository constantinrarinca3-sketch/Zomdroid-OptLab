+                MGLPZStateRunRenderFast.telemetryHits() - g11Hits0,
+                MGLPZStateRunRenderFast.telemetryDraws() - g11Draws0,
+                MGLPZStateRunRenderFast.telemetryOpFallback() - g11Ops0, rb.sequence);
