+        rb.currentRun.length += 4;
+        ++handled;
+        publishMaybe();
+        return true;
+    }
+
+    /** CP6.2 render-tail fastpath: vanilla render plus a proven-safe empty-map clear elision. */
+    public static boolean tryRender(SpriteRenderer.RingBuffer rb) {
