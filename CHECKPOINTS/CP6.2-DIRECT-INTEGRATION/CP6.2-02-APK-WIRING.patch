diff --git a/app/src/main/java/com/zomdroid/fragments/RenderOptimizationDialog.java b/app/src/main/java/com/zomdroid/fragments/RenderOptimizationDialog.java
new file mode 100644
index 0000000..5337ba6
--- /dev/null
+++ b/app/src/main/java/com/zomdroid/fragments/RenderOptimizationDialog.java
@@ -0,0 +1,143 @@
+package com.zomdroid.fragments;
+
+import android.content.Context;
+import android.graphics.Typeface;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.appcompat.widget.SwitchCompat;
+
+import com.zomdroid.OptLabPreferences;
+import com.zomdroid.R;
+
+/** Dedicated Build 42 panel for demonstrated CP6.x render-thread hotpaths. */
+public final class RenderOptimizationDialog {
+    private RenderOptimizationDialog() {}
+
+    public static void show(Context context, Runnable onClosed) {
+        OptLabPreferences prefs = OptLabPreferences.from(context);
+        int pad = dp(context, 16);
+        LinearLayout content = new LinearLayout(context);
+        content.setOrientation(LinearLayout.VERTICAL);
+        content.setPadding(pad, dp(context, 4), pad, pad);
+
+        TextView intro = text(context, context.getString(R.string.opt_lab_render_intro), false);
+        intro.setPadding(0, 0, 0, dp(context, 8));
+        content.addView(intro);
+        TextView summary = text(context, prefs.renderOptimizationSummary(), true);
+        content.addView(summary);
+
+        addSection(content, context, context.getString(R.string.opt_lab_render_profiles));
+        Button safe = button(context, R.string.opt_lab_render_cp62_safe);
+        Button off = button(context, R.string.opt_lab_render_all_off);
+        content.addView(safe);
+        content.addView(off);
+
+        addSection(content, context, context.getString(R.string.opt_lab_render_chunk_depth));
+        SwitchCompat upload = toggle(context, R.string.opt_lab_render_chunk_depth_upload,
+                prefs.isRenderChunkDepthUpload());
+        SwitchCompat lookup = toggle(context, R.string.opt_lab_render_chunk_depth_lookup,
+                prefs.isRenderChunkDepthLookup());
+        content.addView(upload);
+        content.addView(lookup);
+
+        addSection(content, context, context.getString(R.string.opt_lab_render_ring));
+        SwitchCompat emptyClear = toggle(context, R.string.opt_lab_render_ring_empty_clear,
+                prefs.isRenderRingEmptyClear());
+        content.addView(emptyClear);
+
+        TextView bulk = text(context,
+                context.getString(R.string.opt_lab_render_ring_bulk_status), false);
+        bulk.setPadding(0, dp(context, 10), 0, 0);
+        content.addView(bulk);
+
+        TextView warning = text(context,
+                context.getString(R.string.opt_lab_render_restart), false);
+        warning.setPadding(0, dp(context, 12), 0, 0);
+        content.addView(warning);
+
+        final boolean[] updating = {false};
+        Runnable sync = () -> {
+            OptLabPreferences now = OptLabPreferences.from(context);
+            updating[0] = true;
+            upload.setChecked(now.isRenderChunkDepthUpload());
+            lookup.setChecked(now.isRenderChunkDepthLookup());
+            lookup.setEnabled(now.isRenderChunkDepthUpload());
+            emptyClear.setChecked(now.isRenderRingEmptyClear());
+            summary.setText(now.renderOptimizationSummary());
+            updating[0] = false;
+        };
+
+        upload.setOnCheckedChangeListener((view, checked) -> {
+            if (!updating[0]) {
+                prefs.setRenderChunkDepthUpload(checked);
+                sync.run();
+            }
+        });
+        lookup.setOnCheckedChangeListener((view, checked) -> {
+            if (!updating[0]) {
+                prefs.setRenderChunkDepthLookup(checked);
+                sync.run();
+            }
+        });
+        emptyClear.setOnCheckedChangeListener((view, checked) -> {
+            if (!updating[0]) {
+                prefs.setRenderRingEmptyClear(checked);
+                sync.run();
+            }
+        });
+        safe.setOnClickListener(view -> {
+            prefs.setRenderCp62SafeProfile(true);
+            sync.run();
+        });
+        off.setOnClickListener(view -> {
+            prefs.setRenderCp62SafeProfile(false);
+            sync.run();
+        });
+
+        sync.run();
+        ScrollView scroll = new ScrollView(context);
+        scroll.addView(content);
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.opt_lab_render_title)
+                .setView(scroll)
+                .setPositiveButton(R.string.dialog_button_ok, null)
+                .setOnDismissListener(dialog -> onClosed.run())
+                .show();
+    }
+
+    private static SwitchCompat toggle(Context context, int label, boolean checked) {
+        SwitchCompat toggle = new SwitchCompat(context);
+        toggle.setText(label);
+        toggle.setChecked(checked);
+        toggle.setPadding(0, dp(context, 5), 0, dp(context, 5));
+        return toggle;
+    }
+
+    private static Button button(Context context, int label) {
+        Button button = new Button(context);
+        button.setText(label);
+        return button;
+    }
+
+    private static TextView text(Context context, String value, boolean bold) {
+        TextView view = new TextView(context);
+        view.setText(value);
+        view.setTextSize(13);
+        if (bold) view.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
+        return view;
+    }
+
+    private static void addSection(LinearLayout parent, Context context, String value) {
+        TextView label = text(context, value, true);
+        label.setPadding(0, dp(context, 14), 0, dp(context, 4));
+        parent.addView(label);
+    }
+
+    private static int dp(Context context, int value) {
+        return Math.round(value * context.getResources().getDisplayMetrics().density);
+    }
+}
