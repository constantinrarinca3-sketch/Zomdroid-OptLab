+#!/usr/bin/env bash
+set -euo pipefail
+export TZ=UTC
+
+PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+JAR_4220="${1:-${PZ_4220_JAR:-}}"
+JAR_42203="${2:-${PZ_42203_JAR:-}}"
+if [[ -z "$JAR_4220" || -z "$JAR_42203" ]]; then
+  echo "usage: $0 <projectzomboid-42.20.jar> <projectzomboid-42.20.3.jar>" >&2
+  exit 2
+fi
+
+WORK_DIR="$(mktemp -d)"
