+trap 'rm -rf -- "$WORK_DIR"' EXIT
+
+fail() {
+  echo "R15_FINAL_QA FAIL $*" >&2
+  exit 1
+}
+
+assert_sha() {
+  local path="$1"
+  local expected="$2"
+  [[ -f "$path" ]] || fail "missing=$path"
+  local actual
+  actual="$(sha256sum "$path" | awk '{print $1}')"
+  [[ "$actual" == "$expected" ]] \
+    || fail "sha file=$path actual=$actual expected=$expected"
+}
