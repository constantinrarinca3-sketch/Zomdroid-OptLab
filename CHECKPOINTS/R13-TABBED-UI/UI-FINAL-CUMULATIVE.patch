+    private void syncAll() {
+        if (!uiReady) return;
+        updating = true;
+        boolean safe = prefs.isSafeModeEnabled();
+        boolean general = prefs.isMasterEnabled();
+
+        safeMode.toggle.setChecked(safe);
+        safeMode.subtitle.setText(getString(safe
+                ? R.string.opt_lab_safe_mode_active : R.string.opt_lab_safe_mode_summary));
+        select(profileCard, generalProfile(prefs.getProfile()));
+        profileCard.setEnabled(!safe);
+
+        generalMaster.toggle.setChecked(general);
+        quiet.toggle.setChecked(prefs.isQuietRuntime());
+        buffered.toggle.setChecked(prefs.getStdioMode() == OptLabPreferences.StdioMode.BUFFERED);
+        sqlite.toggle.setChecked(prefs.isSqliteAndroidNative());
+        select(box64, prefs.getBox64Policy());
+        generalMaster.setEnabled(!safe);
+        setEnabled(!safe && general, quiet, buffered, sqlite);
+        box64.setEnabled(!safe && general);
+
+        surface.toggle.setChecked(prefs.getSurfaceMode() == OptLabPreferences.SurfaceMode.GEN_ACK);
+        refresh.toggle.setChecked(prefs.getDisplayFpsHint()
+                == OptLabPreferences.DisplayFpsHint.NATIVE_REFRESH);
+        inputQueue.toggle.setChecked(prefs.getInputQueueMode()
+                == OptLabPreferences.InputQueueMode.MUTEX_SAFE);
+        analog.toggle.setChecked(prefs.isAnalogFilter());
+        coalesce.toggle.setChecked(prefs.isInputCoalesce());
+        mobileGlLog.toggle.setChecked(prefs.isMobileGlFileLogEnabled());
+        setEnabled(!safe && general, surface, refresh, inputQueue, analog, coalesce, mobileGlLog);
+
+        onlyBuild42.toggle.setChecked(prefs.isOnlyBuild42());
+        pacing.toggle.setChecked(prefs.isMainloopPacing());
+        streamWake.toggle.setChecked(prefs.isStreamWake());
+        streamQueue.toggle.setChecked(prefs.isStreamQueueFast());
+        streamEta.toggle.setChecked(prefs.isStreamVelocityEta());
+        fboDedup.toggle.setChecked(prefs.isFboDirtyDedup());
+        fboBudget.toggle.setChecked(prefs.isFboFrameBudget());
+        streamFboCoordinator.toggle.setChecked(prefs.isStreamFboCoordinator());
+        chunkForage.toggle.setChecked(prefs.isChunkForage());
+        chunkNeighbourWorker.toggle.setChecked(prefs.isChunkNeighbourWorker());
+        chunkNeighbourMain.toggle.setChecked(prefs.isChunkNeighbourMain());
+        chunkGrid.toggle.setChecked(prefs.isChunkGridLoad());
+        chunkVehicles.toggle.setChecked(prefs.isChunkVehicles());
+        chunkBuildings.toggle.setChecked(prefs.isChunkRandomizedBuildings());
+        chunkLua.toggle.setChecked(prefs.isChunkLuaMapObjects());
+        chunkWorldgen.toggle.setChecked(prefs.isChunkWorldgenBiome());
+        renderUpload.toggle.setChecked(prefs.isRenderChunkDepthUpload());
+        renderLookup.toggle.setChecked(prefs.isRenderChunkDepthLookup());
+        renderRingClear.toggle.setChecked(prefs.isRenderRingEmptyClear());
+        setEnabled(!safe, onlyBuild42, pacing, streamWake, streamQueue, streamEta,
+                fboDedup, fboBudget, chunkForage, chunkNeighbourWorker, chunkNeighbourMain,
+                chunkGrid, chunkVehicles, chunkBuildings, chunkLua, chunkWorldgen,
+                renderUpload, renderRingClear);
+        streamFboCoordinator.setEnabled(!safe && prefs.isFboFrameBudget());
+        renderLookup.setEnabled(!safe && prefs.isRenderChunkDepthUpload());
+        for (MaterialButton button : build42Buttons) button.setEnabled(!safe);
+
+        lighting.toggle.setChecked(nativePrefs.isLighting64Enabled());
+        clipper.toggle.setChecked(nativePrefs.isPzClipperEnabled());
+        pathfinding.toggle.setChecked(nativePrefs.isPathfindingEnabled());
+        popMan.toggle.setChecked(nativePrefs.isPopManEnabled());
+        cp2c.toggle.setChecked(prefs.isChunkCp2cDirtyClear());
+        setEnabled(!safe, lighting, clipper, pathfinding, popMan, cp2c);
+
+        int runtimeCount = runtimeCount();
+        int displayCount = displayCount();
+        int build42Count = build42Count();
+        int experimentalCount = (nativePrefs.isPathfindingEnabled() ? 1 : 0)
+                + (nativePrefs.isPopManEnabled() ? 1 : 0)
+                + (prefs.isChunkCp2cDirtyClear() ? 1 : 0);
+        overviewRuntime.subtitle.setText(safe
+                ? getString(R.string.opt_lab_safe_mode_state)
+                : getString(R.string.opt_lab_active_count, runtimeCount));
+        overviewDisplay.subtitle.setText(safe
+                ? getString(R.string.opt_lab_safe_mode_state)
+                : getString(R.string.opt_lab_active_count, displayCount));
+        overviewBuild42.subtitle.setText(safe
+                ? getString(R.string.opt_lab_safe_mode_state)
+                : getString(R.string.opt_lab_build42_card_state,
